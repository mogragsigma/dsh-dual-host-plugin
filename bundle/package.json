{
  "name": "@mogragsigma/dsh-dual-host-plugin",
  "version": "2.0.1",
  "type": "module",
  "exports": {
    ".": "./native-entry.js",
    "./package.json": "./package.json",
    "./native-tools": "./native-tools.js",
    "./client": "./workbench-client.js"
  },
  "description": "Single-owner native cloud tasks for DeepSeek Harness, with local and IM entry, continuous follow-up and verifiable artifacts",
  "files": [
    "*.js",
    "cordis.patch.yml",
    "skills",
    "rules",
    "worker-rules",
    "native-rules",
    "global-rules",
    "compatibility.json",
    "approval-ui",
    "package-lock.json",
    "workbench-assets",
    "development-rules",
    "delivery-process.py",
    "runtime-package.json",
    "runtime-lock.json",
    "onboarding-node-bootstrap.py",
    "runtime-im-package.json",
    "runtime-im-lock.json",
    "distribution-lock.json",
    "README.md",
    "LICENSE",
    "LICENSE.en.md",
    "THIRD_PARTY_NOTICES.md",
    "ASSET_NOTICE.md",
    "SETUP.md",
    "configuration-v2.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "acorn": "8.15.0",
    "koffi": "3.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.5 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-llm-deepseek": ">=0.2.1-rc.5 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.1-rc.5 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0",
    "@earendil-works/pi-ai": ">=1.3.0 <1.6.0",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.5 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.5 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-http-proxy": ">=0.2.1-rc.5 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-web-fetch-http": ">=0.2.1-rc.5 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-web-search-deepseek": ">=0.2.1-rc.5 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@deepseek-ai/dsh-http-proxy": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-web-search-deepseek": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-web-fetch-http": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-deepseek": {
      "optional": true
    }
  },
  "author": "mogragsigma",
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/mogragsigma/dsh-dual-host-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mogragsigma/dsh-dual-host-plugin.git",
    "directory": "bundle"
  },
  "bugs": {
    "url": "https://github.com/mogragsigma/dsh-dual-host-plugin/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dual-host",
    "cloud-tasks"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0"
  }
}
