{
  "name": "@mogragsigma/dsh-dual-host-plugin",
  "version": "0.33.1",
  "description": "Local and cloud DSH coordination with protected onboarding, task approval and controlled artifacts",
  "type": "module",
  "private": false,
  "exports": {
    ".": "./bundle/native-entry.js",
    "./native-tools": "./bundle/native-tools.js",
    "./client": "./bundle/workbench-client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "files": [
    "bundle",
    "!bundle/node_modules",
    "!bundle/private",
    "cordis.patch.yml",
    "compatibility.json",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-http-proxy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-web-fetch-http": "0.2.1-rc.2",
    "@deepseek-ai/dsh-web-search-deepseek": "0.2.1-rc.2",
    "@js-temporal/polyfill": "0.5.1",
    "acorn": "8.15.0",
    "koffi": "3.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@earendil-works/pi-ai": "1.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  }
}
